# Logs
LOG_LEVEL=DEBUG
LOG_TO_CONSOLE=true
LOG_MAX_FRAMES=10

# FastAPI
HOST=0.0.0.0
PORT=8000
UC_LOG_LEVEL=critical

# Tempo / OpenTelemetry
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=districts
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.monitoring.svc:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_RESOURCE_ATTRIBUTES="service.namespace=districts"
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS="health,metrics"
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY_MS=5000
OTEL_EXPORTER_OTLP_TIMEOUT=3

# PostgreSQL / PostGIS
DB_DIALECT=postgresql
DB_DRIVER=asyncpg
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=55433
DB_NAME=postgres
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=30
DB_SSL_ENABLED=false
DB_SSL_MODE=require
DB_SSL_CA_PATH=
DB_SSL_CERT_PATH=
DB_SSL_KEY_PATH=

# Redis
CACHE_USER=
CACHE_PASSWORD=
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_DB=0
CACHE_DECODE_RESPONSES=true
CACHE_MAX_CONNECTIONS=20
CACHE_SOCKET_TIMEOUT=5
CACHE_SOCKET_CONNECT_TIMEOUT=10
CACHE_HEALTH_CHECK_INTERVAL=15
CACHE_KEY_PREFIX=geo

# Overpass API
OVERPASS_BASE_URL=https://overpass-api.de
OVERPASS_TIMEOUT_S=120
OVERPASS_USER_AGENT=districts-osm/1.0
OVERPASS_RPS_LIMIT=1.0
OVERPASS_RETRY_ATTEMPTS=3
OVERPASS_RETRY_BACKOFF_S=2.0

# Districts
NEAREST_MAX_DISTANCE_M=5000
AUTOLOAD_COOLDOWN_SECONDS=300
